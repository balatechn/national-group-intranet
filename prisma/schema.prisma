generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id                String              @id @default(cuid())
  employeeId        String              @unique
  email             String              @unique
  password          String
  firstName         String
  lastName          String
  displayName       String?
  phone             String?
  avatar            String?
  role              UserRole            @default(EMPLOYEE)
  status            UserStatus          @default(ACTIVE)
  jobTitle          String?
  companyId         String?
  departmentId      String?
  managerId         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  hourlyRate        Float?
  attendances       Attendance[]        @relation("UserAttendance")
  auditLogs         AuditLog[]
  chatMemberships   ChatMember[]
  sentMessages      ChatMessage[]       @relation("MessageSender")
  departmentsHeaded Department[]        @relation("DepartmentHead")
  eventsCreated     Event[]             @relation("EventCreator")
  eventAttendees    EventAttendee[]
  itRequests        ITRequest[]         @relation("RequestCreator")
  approvedRequests  ITRequestApproval[]
  assignedTickets   ITTicket[]          @relation("TicketAssignee")
  createdTickets    ITTicket[]          @relation("TicketCreator")
  assignedMobiles   MobileDevice[]
  notifications     Notification[]
  projectsOwned     Project[]           @relation("ProjectOwner")
  projectMembers    ProjectMember[]
  assignedSystems   SystemAsset[]
  assignedTasks     Task[]              @relation("TaskAssignee")
  createdTasks      Task[]              @relation("TaskCreator")
  taskAttachments   TaskAttachment[]    @relation("TaskAttachmentUploader")
  taskComments      TaskComment[]       @relation("TaskCommentAuthor")
  taskMentions      TaskMention[]       @relation("TaskMentionUser")
  taskTemplates     TaskTemplate[]      @relation("TaskTemplateCreator")
  taskTimeEntries   TaskTimeEntry[]     @relation("TaskTimeEntryUser")
  taskTimeLogs      TaskTimeLog[]       @relation("UserTaskTimeLogs")
  ticketComments    TicketComment[]
  regularizations   AttendanceRegularization[] @relation("UserRegularizations")
  reviewedRegularizations AttendanceRegularization[] @relation("RegularizationReviewer")
  company           Company?            @relation(fields: [companyId], references: [id])
  department        Department?         @relation(fields: [departmentId], references: [id])
  manager           User?               @relation("UserManager", fields: [managerId], references: [id])
  subordinates      User[]              @relation("UserManager")

  @@index([companyId])
  @@index([departmentId])
  @@index([managerId])
  @@index([email])
  @@index([employeeId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model Company {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  shortName      String?
  description    String?
  logo           String?
  website        String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  taxId          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parentId       String?
  parent         Company?       @relation("CompanyHierarchy", fields: [parentId], references: [id])
  subsidiaries   Company[]      @relation("CompanyHierarchy")
  departments    Department[]
  events         Event[]
  mobileDevices  MobileDevice[]
  policies       Policy[]
  projects       Project[]
  softwareAssets Software[]
  systemAssets   SystemAsset[]
  users          User[]
  vendors        Vendor[]

  @@index([code])
  @@index([isActive])
  @@index([parentId])
}

model Department {
  id             String         @id @default(cuid())
  code           String
  name           String
  description    String?
  isActive       Boolean        @default(true)
  companyId      String
  headId         String?
  parentId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  head           User?          @relation("DepartmentHead", fields: [headId], references: [id])
  parent         Department?    @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[]   @relation("DepartmentHierarchy")
  events         Event[]
  policies       Policy[]
  projects       Project[]
  sharedFolders  SharedFolder[]
  softwareAssets Software[]
  systemAssets   SystemAsset[]
  tasks          Task[]
  taskTemplates  TaskTemplate[]
  users          User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([headId])
  @@index([isActive])
}

model Task {
  id             String           @id @default(cuid())
  title          String
  description    String?
  priority       TaskPriority     @default(MEDIUM)
  status         TaskStatus       @default(TODO)
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?
  creatorId      String
  assigneeId     String?
  departmentId   String?
  projectId      String?
  ticketId       String?
  parentId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isRecurring    Boolean          @default(false)
  nextOccurrence DateTime?
  recurrenceEnd  DateTime?
  recurrenceType RecurrenceType?
  reminderDate   DateTime?
  reminderSent   Boolean          @default(false)
  templateId     String?
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator        User             @relation("TaskCreator", fields: [creatorId], references: [id])
  department     Department?      @relation(fields: [departmentId], references: [id])
  parent         Task?            @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks       Task[]           @relation("TaskSubtasks")
  project        Project?         @relation(fields: [projectId], references: [id])
  template       TaskTemplate?    @relation(fields: [templateId], references: [id])
  ticket         ITTicket?        @relation(fields: [ticketId], references: [id])
  attachments    TaskAttachment[]
  comments       TaskComment[]
  blockedTasks   TaskDependency[] @relation("BlockingTask")
  dependsOn      TaskDependency[] @relation("DependentTask")
  timeEntries    TaskTimeEntry[]
  timeLogs       TaskTimeLog[]

  @@index([creatorId])
  @@index([assigneeId])
  @@index([departmentId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isRecurring])
  @@index([reminderDate])
}

model TaskComment {
  id        String        @id @default(cuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentions  TaskMention[]

  @@index([taskId])
  @@index([authorId])
}

model TaskTemplate {
  id              String       @id @default(cuid())
  name            String
  description     String?
  title           String
  taskDescription String?
  priority        TaskPriority @default(MEDIUM)
  estimatedHours  Float?
  creatorId       String
  departmentId    String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tasks           Task[]
  creator         User         @relation("TaskTemplateCreator", fields: [creatorId], references: [id])
  department      Department?  @relation(fields: [departmentId], references: [id])

  @@index([creatorId])
  @@index([departmentId])
  @@index([isActive])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  taskId       String
  uploadedById String
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([uploadedById])
}

model TaskDependency {
  id              String   @id @default(cuid())
  dependentTaskId String
  blockingTaskId  String
  createdAt       DateTime @default(now())
  blockingTask    Task     @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  dependentTask   Task     @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, blockingTaskId])
  @@index([dependentTaskId])
  @@index([blockingTaskId])
}

model TaskTimeEntry {
  id          String   @id @default(cuid())
  description String?
  hours       Float
  date        DateTime @default(now())
  taskId      String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cost        Float    @default(0)
  hourlyRate  Float    @default(0)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation("TaskTimeEntryUser", fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([date])
}

model TaskMention {
  id        String      @id @default(cuid())
  commentId String
  userId    String
  notified  Boolean     @default(false)
  createdAt DateTime    @default(now())
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation("TaskMentionUser", fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Project {
  id            String             @id @default(cuid())
  code          String
  name          String
  description   String?
  status        ProjectStatus      @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  actualEndDate DateTime?
  budget        Float?
  companyId     String
  departmentId  String?
  ownerId       String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  company       Company            @relation(fields: [companyId], references: [id])
  department    Department?        @relation(fields: [departmentId], references: [id])
  owner         User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  milestones    ProjectMilestone[]
  tasks         Task[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      String?
  projectId String
  userId    String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Event {
  id           String          @id @default(cuid())
  title        String
  description  String?
  type         EventType       @default(OTHER)
  location     String?
  isAllDay     Boolean         @default(false)
  startDate    DateTime
  endDate      DateTime
  recurrence   String?
  isPublic     Boolean         @default(true)
  companyId    String?
  departmentId String?
  creatorId    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company?        @relation(fields: [companyId], references: [id])
  creator      User            @relation("EventCreator", fields: [creatorId], references: [id])
  department   Department?     @relation(fields: [departmentId], references: [id])
  attendees    EventAttendee[]

  @@index([companyId])
  @@index([departmentId])
  @@index([creatorId])
  @@index([startDate])
  @@index([type])
}

model EventAttendee {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Policy {
  id            String          @id @default(cuid())
  code          String
  title         String
  description   String?
  content       String?
  category      PolicyCategory
  status        PolicyStatus    @default(DRAFT)
  version       String          @default("1.0")
  effectiveDate DateTime?
  expiryDate    DateTime?
  fileUrl       String?
  companyId     String?
  departmentId  String?
  createdBy     String
  approvedBy    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?
  company       Company?        @relation(fields: [companyId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  versions      PolicyVersion[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([category])
  @@index([status])
}

model PolicyVersion {
  id          String   @id @default(cuid())
  version     String
  content     String?
  fileUrl     String?
  changeNotes String?
  policyId    String
  createdBy   String
  createdAt   DateTime @default(now())
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model ITTicket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique
  subject       String
  description   String
  category      TicketCategory
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  creatorId     String
  assigneeId    String?
  slaDeadline   DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  systemAssetId String?
  softwareId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  assignee      User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  creator       User            @relation("TicketCreator", fields: [creatorId], references: [id])
  software      Software?       @relation(fields: [softwareId], references: [id])
  systemAsset   SystemAsset?    @relation(fields: [systemAssetId], references: [id])
  tasks         Task[]
  comments      TicketComment[]

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([ticketNumber])
}

model TicketComment {
  id         String   @id @default(cuid())
  content    String
  isInternal Boolean  @default(false)
  ticketId   String
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation(fields: [authorId], references: [id])
  ticket     ITTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
}

model ITRequest {
  id            String              @id @default(cuid())
  requestNumber String              @unique
  type          ITRequestType
  subject       String
  description   String
  justification String?
  status        ITRequestStatus     @default(DRAFT)
  requestorId   String
  details       Json?
  systemAssetId String?
  softwareId    String?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  requestor     User                @relation("RequestCreator", fields: [requestorId], references: [id])
  approvals     ITRequestApproval[]

  @@index([requestorId])
  @@index([status])
  @@index([type])
  @@index([requestNumber])
}

model ITRequestApproval {
  id         String         @id @default(cuid())
  level      Int            @default(1)
  status     ApprovalStatus @default(PENDING)
  comments   String?
  requestId  String
  approverId String
  approvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  approver   User           @relation(fields: [approverId], references: [id])
  request    ITRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId, level])
  @@index([requestId])
  @@index([approverId])
  @@index([status])
}

model SystemAsset {
  id                String          @id @default(cuid())
  assetTag          String          @unique
  serialNumber      String?
  name              String
  type              AssetType
  manufacturer      String?
  model             String?
  status            AssetStatus     @default(AVAILABLE)
  processor         String?
  ram               String?
  storage           String?
  operatingSystem   String?
  osVersion         String?
  companyId         String?
  departmentId      String?
  assignedToId      String?
  assignedAt        DateTime?
  purchaseDate      DateTime?
  warrantyExpiry    DateTime?
  purchasePrice     Float?
  vendorId          String?
  amcStartDate      DateTime?
  amcEndDate        DateTime?
  amcVendorId       String?
  location          String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  installedSoftware AssetSoftware[]
  tickets           ITTicket[]
  assignedTo        User?           @relation(fields: [assignedToId], references: [id])
  company           Company?        @relation(fields: [companyId], references: [id])
  department        Department?     @relation(fields: [departmentId], references: [id])
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([companyId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@index([assetTag])
}

model Software {
  id            String          @id @default(cuid())
  name          String
  version       String?
  publisher     String?
  description   String?
  category      String?
  licenseType   LicenseType     @default(PERPETUAL)
  licenseKey    String?
  totalLicenses Int             @default(1)
  usedLicenses  Int             @default(0)
  companyId     String?
  departmentId  String?
  purchasePrice Float?
  renewalPrice  Float?
  purchaseDate  DateTime?
  expiryDate    DateTime?
  renewalDate   DateTime?
  vendorId      String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  installations AssetSoftware[]
  tickets       ITTicket[]
  company       Company?        @relation(fields: [companyId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  vendor        Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([companyId])
  @@index([departmentId])
  @@index([vendorId])
  @@index([licenseType])
  @@index([expiryDate])
  @@index([isActive])
}

model AssetSoftware {
  id          String      @id @default(cuid())
  assetId     String
  softwareId  String
  installedAt DateTime    @default(now())
  asset       SystemAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  software    Software    @relation(fields: [softwareId], references: [id])

  @@unique([assetId, softwareId])
  @@index([assetId])
  @@index([softwareId])
}

model MobileDevice {
  id              String      @id @default(cuid())
  assetTag        String      @unique
  imei            String?
  serialNumber    String?
  deviceType      String
  manufacturer    String?
  model           String?
  status          AssetStatus @default(AVAILABLE)
  simNumber       String?
  operator        String?
  mobileNumber    String?
  planType        String?
  planDetails     String?
  companyId       String?
  assignedToId    String?
  assignedAt      DateTime?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  purchasePrice   Float?
  monthlyPlanCost Float?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  assignedTo      User?       @relation(fields: [assignedToId], references: [id])
  company         Company?    @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([assignedToId])
  @@index([status])
  @@index([assetTag])
}

model Vendor {
  id            String        @id @default(cuid())
  code          String
  name          String
  type          String?
  description   String?
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  taxId         String?
  panNumber     String?
  gstNumber     String?
  contractStart DateTime?
  contractEnd   DateTime?
  notes         String?
  isActive      Boolean       @default(true)
  companyId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  software      Software[]
  systemAssets  SystemAsset[]
  company       Company?      @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
}

model SharedFolder {
  id            String             @id @default(cuid())
  name          String
  description   String?
  driveId       String
  folderId      String
  webUrl        String?
  isCompanyWide Boolean            @default(false)
  departmentId  String?
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  permissions   FolderPermission[]
  department    Department?        @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([isCompanyWide])
}

model FolderPermission {
  id        String       @id @default(cuid())
  role      String
  folderId  String
  userId    String?
  userRole  UserRole?
  createdAt DateTime     @default(now())
  folder    SharedFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  userId    String
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  priority    String    @default("normal")
  isPinned    Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([publishedAt])
  @@index([isPinned])
}

model RolePermission {
  id            String    @id @default(cuid())
  role          UserRole
  module        AppModule
  canView       Boolean   @default(false)
  canEdit       Boolean   @default(false)
  companyIds    String[]  @default([])
  departmentIds String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([role, module])
  @@index([role])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  group       String?
  updatedAt   DateTime @updatedAt

  @@index([group])
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String?
  isGroup   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   ChatMember[]
  messages  ChatMessage[]

  @@index([updatedAt])
}

model ChatMember {
  id         String   @id @default(cuid())
  userId     String
  roomId     String
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  roomId    String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderId])
}

model Attendance {
  id              String              @id @default(cuid())
  userId          String
  date            DateTime            @db.Date
  status          AttendanceStatus    @default(CHECKED_IN)
  locationType    WorkLocationType    @default(OFFICE)
  checkInIp       String?
  checkOutIp      String?
  checkInLocation String?
  totalMinutes    Int                 @default(0)
  breakMinutes    Int                 @default(0)
  workMinutes     Int                 @default(0)
  overtimeMinutes Int                 @default(0)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  firstCheckIn    DateTime            @default(now())
  isCurrentlyIn   Boolean             @default(false)
  lastCheckOut    DateTime?
  user            User                @relation("UserAttendance", fields: [userId], references: [id])
  breaks          AttendanceBreak[]
  sessions        AttendanceSession[]
  taskTimeLogs    TaskTimeLog[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model AttendanceSession {
  id              String           @id @default(cuid())
  attendanceId    String
  checkInAt       DateTime
  checkOutAt      DateTime?
  locationType    WorkLocationType @default(OFFICE)
  location        String?
  durationMinutes Int              @default(0)
  notes           String?
  createdAt       DateTime         @default(now())
  attendance      Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@index([checkInAt])
}

model AttendanceBreak {
  id           String     @id @default(cuid())
  attendanceId String
  breakType    BreakType  @default(SHORT_BREAK)
  startTime    DateTime
  endTime      DateTime?
  duration     Int        @default(0)
  notes        String?
  createdAt    DateTime   @default(now())
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model TaskTimeLog {
  id              String     @id @default(cuid())
  attendanceId    String
  taskId          String
  userId          String
  startTime       DateTime?
  endTime         DateTime?
  minutes         Int        @default(0)
  isAutoAllocated Boolean    @default(false)
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  task            Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User       @relation("UserTaskTimeLogs", fields: [userId], references: [id])

  @@index([attendanceId])
  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model AttendanceRegularization {
  id              String                       @id @default(cuid())
  userId          String
  requestDate     DateTime                     @db.Date
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason          String
  status          RegularizationStatus         @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  user            User                         @relation("UserRegularizations", fields: [userId], references: [id])
  reviewer        User?                        @relation("RegularizationReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestDate])
}

